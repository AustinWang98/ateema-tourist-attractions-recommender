# Copy this file to .env and fill in real values. Never commit .env.
# The app runs without an LLM key by using a deterministic itinerary fallback.
# For a hosted deployment, use an approved account and a secret manager.

# --- LLM (OpenAI-compatible API) — default: OpenAI cloud ---
OPENAI_API_KEY=                 # set only in your local or hosted environment
OPENAI_BASE_URL=openai           # "openai" = official cloud; "ollama" = local
OPENAI_MODEL=gpt-4o-mini         # or gpt-4o for higher quality
# Free local Ollama instead: OPENAI_BASE_URL=ollama  OPENAI_MODEL=llama3.1:8b  (run `ollama serve`)
# Groq example: OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.3-70b-versatile

# Restricted local caches are optional and must remain under data/private/.
# `python -m backend.refresh` writes these files after BigQuery authentication.
DATA_CSV_PATH=data/private/user_location_features.csv
EVENTS_PATH=data/demo_events.csv
LOCATION_DIM_PATH=data/location_dim.csv
GEO_PATH=data/locations_geo.csv
# To test a restricted local export instead of the synthetic fixture, set:
# EVENTS_PATH=data/private/events.csv

# Persistent on-disk cache for LLM responses (keyed by model + prompt hash).
# Delete this file to bust the cache.
LLM_CACHE_PATH=data/llm_cache.sqlite

# Set to 0 to bypass the cache (useful while iterating on prompts).
LLM_CACHE_ENABLED=1

# --------------------------------------------------------------------------- #
# BigQuery data source (production, optional for demo deploys).
# Startup order:
#   1. BigQuery when BQ_PROJECT + BQ_DATASET are set.
#   2. Full local cache at DATA_CSV_PATH.
#   3. Checked-in synthetic demo fallback from location_dim/demo_events/geo.
#
# Local authentication: run `gcloud auth application-default login` once.
# In Cloud Run, attach an organization-owned service account instead of using a
# downloaded key. Never commit credentials or private warehouse exports.
# --------------------------------------------------------------------------- #
BQ_PROJECT=
BQ_DATASET=
BQ_TABLE_FEATURES=user_location_full_features
BQ_TABLE_LOCATION_DIM=location_dim
BQ_TABLE_EVENTS=user_location_category_events

# Optional additive boost for catalog entries carrying the HOT SPOTS flag.
# Tune this value for your deployment and document the policy for users.
HOT_SPOT_BOOST=0.12

# Feedback-loop guard: recommender-origin outbound clicks are logged separately
# and lightly penalized so the product does not inflate its own future rankings.
FEEDBACK_GUARD_ENABLED=true
FEEDBACK_GUARD_WINDOW_DAYS=30
FEEDBACK_GUARD_STRENGTH=0.08
RECOMMENDER_OUTBOUND_CLICKS_PATH=data/outbound_clicks.jsonl
